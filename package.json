{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "test:spread": "node scripts/run-tests.mjs --node-arg=--experimental-strip-types --node-arg=--import --node-arg=./src/test-support/register.mjs --find src .test.ts",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "npm run test:spread && npm run test:scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "export:ios": "node scripts/export-ios.mjs",
    "ios:sync": "npm run export:ios && npx --yes @capacitor/cli@8.5.1 sync ios",
    "ios:open": "npm run ios:sync && npx --yes @capacitor/cli@8.5.1 open ios",
    "test:scripts": "node scripts/run-tests.mjs --find scripts .test.mjs",
    "docs:tokens": "node scripts/design-tokens.mjs --write",
    "docs:sync": "node scripts/design-docs.mjs --sync",
    "docs:check": "node scripts/design-docs.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@electric-sql/pglite": "^0.5.4",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@vitejs/plugin-react": "^5.2.0",
    "better-auth": "~1.6.30",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "jose": "6.2.9",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  }
}
